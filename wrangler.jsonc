{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "steven-mail",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "mail.steventeng.uk", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "steven-mail",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MAIL_BUCKET", "bucket_name": "steven-mail-storage" }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["steven@steventeng.uk"]
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "steventeng2022@gmail.com",
    "MAILBOX_ADDRESS": "steven@steventeng.uk",
    "MAILBOX_NAME": "Steven Teng"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
